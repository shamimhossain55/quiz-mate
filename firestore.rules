rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users collection (RBAC Role Management) ──────────────────────────
    // Block all direct client-side reads and writes to the users collection.
    // All role lookups and updates MUST go through the server-side Firebase Admin SDK.
    match /users/{email} {
      allow read: if false;
      allow write: if false;
    }

    // ── Students collection ──────────────────────────────────────────────
    match /students/{email} {
      allow read: if true;
      allow write: if false;
    }

    // ── Social & Friends ──────────────────────────────────────────────────
    match /friends/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /friend_requests/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Learning & Quiz Content ──────────────────────────────────────────
    match /subjects/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /classes/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /banners/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /chapters/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /quizzes/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /results/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Conversations & Messaging ────────────────────────────────────────
    match /conversations/{convId} {
      allow read: if true;
      allow write: if false;

      match /messages/{msgId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Fallback: Deny access to all other documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
